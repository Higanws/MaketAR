generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Usuario interno de la instancia local. Solo se usa `email` (local@maketar.app).
model User {
  id        String    @id @default(uuid())
  email     String    @unique
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Metadatos del proyecto. El documento del editor vive en `Diagram`.
model Project {
  id           String    @id @default(uuid())
  name         String
  kind         String    @default("mixed")
  template     String?
  flowTemplate String?
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagrams     Diagram[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Persistencia del `EditorDocument` serializado (`canvasJson` + `viewportJson`).
/// Hoy la app usa un diagrama MIXED por proyecto vía `project-repository`.
model Diagram {
  id           String           @id @default(uuid())
  projectId    String
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  type         DiagramType
  canvasJson   Json
  viewportJson Json?
  thumbnailUrl String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

enum DiagramType {
  WIREFRAME
  FLOWCHART
  MIXED
}
