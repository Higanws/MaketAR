generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String?
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id        String    @id @default(uuid())
  name      String
  kind      String    @default("mixed")
  template  String?
  flowTemplate String?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagrams  Diagram[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Diagram {
  id            String           @id @default(uuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  type          DiagramType
  canvasJson    Json
  viewportJson  Json?
  thumbnailUrl  String?
  versions      DiagramVersion[]
  assets        Asset[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model DiagramVersion {
  id        String   @id @default(uuid())
  diagramId String
  diagram   Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  snapshot  Json
  createdAt DateTime @default(now())
}

model Asset {
  id        String   @id @default(uuid())
  diagramId String
  diagram   Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  type      String
  url       String
  metadata  Json?
  createdAt DateTime @default(now())
}

enum DiagramType {
  WIREFRAME
  FLOWCHART
  MIXED
}
